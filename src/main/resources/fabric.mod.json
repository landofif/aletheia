{
	"schemaVersion": 1,
	"id": "aletheia",
	"version": "${version}",
	"name": "Aletheia",
	"description": "Surfaces what Telos Realms buries: dungeon chat as on-screen titles, the server's own HUD numbers as readouts you can place, and shorter chat.",
	"authors": [
		"landofif"
	],
	"license": "MIT",
	"icon": "assets/aletheia/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.landofif.aletheia.AletheiaClient"
		],
		"modmenu": [
			"dev.landofif.aletheia.config.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "aletheia.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=25",
		"fabric-api": "*",
		"yet_another_config_lib_v3": "*"
	}
}
